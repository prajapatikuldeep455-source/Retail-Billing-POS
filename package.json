{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:ui": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server.ts",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:server\"",
    "dev:electron": "concurrently -k \"npm run dev:ui\" \"npm run dev:server\" \"wait-on tcp:3000 tcp:3001 && electron .\"",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --outfile=server.cjs --external:@libsql/client --external:sqlite3",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs release",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "dist:win": "npm run build && npm run build:server && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "papaparse": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.1",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS Machine",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Machine"
    },
    "files": [
      "dist/**/*",
      "server.cjs",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
